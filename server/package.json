{
  "name": "@ovl/server",
  "version": "0.1.0",
  "private": true,
  "description": "OVL For Business API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@ovl/shared": "workspace:*",
    "@simplewebauthn/server": "^14.0.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pdfkit": "~0.17.2",
    "postgres": "^3.4.9",
    "qrcode": "1.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ovl/sdk": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "http_ece": "^1.2.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1",
    "ws": "^8.18.3"
  }
}
