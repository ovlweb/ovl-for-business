{
  "name": "@ovl/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android and iOS apps: Capacitor shell around the @ovl/web client",
  "type": "module",
  "scripts": {
    "build:web": "pnpm --filter @ovl/web build",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "pnpm build:web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "pnpm sync && cap run android",
    "run:ios": "pnpm sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
