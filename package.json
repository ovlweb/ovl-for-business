{
  "name": "ovl-for-business",
  "private": true,
  "version": "0.1.0",
  "description": "OVL For Business — corporate accounts, licenses, registry, stock exchange and messaging platform",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:server": "pnpm --filter @ovl/server dev",
    "dev:web": "pnpm --filter @ovl/web dev",
    "dev:admin": "pnpm --filter @ovl/admin dev",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "pnpm --filter @ovl/server db:generate",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
