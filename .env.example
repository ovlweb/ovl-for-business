# Copy to .env next to docker-compose.yml and change every secret.

POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-owner-password

# Public addresses. Use real domains to get automatic HTTPS from Caddy, e.g.
#   WEB_ADDRESS=business.example.com
#   ADMIN_ADDRESS=admin.business.example.com
WEB_ADDRESS=:8080
ADMIN_ADDRESS=:8081

# Only needed when the API lives on another origin than the apps.
PUBLIC_API_URL=
CORS_ORIGINS=*

# Platform rules
COUNCIL_QUORUM=3
STOCK_FREEZE_PERCENT=30
STOCK_LOCK_DAYS=90
