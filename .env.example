# Copy to .env next to docker-compose.yml and change every secret.

POSTGRES_PASSWORD=change-me-db-password
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-owner-password

# Public addresses. Use real domains to get automatic HTTPS from Caddy, e.g.
#   WEB_ADDRESS=business.example.com
#   ADMIN_ADDRESS=admin.business.example.com
WEB_ADDRESS=:8080
ADMIN_ADDRESS=:8081

# Only needed when the API lives on another origin than the apps.
PUBLIC_API_URL=
CORS_ORIGINS=*

# Platform rules
COUNCIL_QUORUM=3
STOCK_FREEZE_PERCENT=30
STOCK_LOCK_DAYS=90

# Email (confirmations, password resets). Without SMTP_URL, emails are only logged.
PUBLIC_WEB_URL=https://business.example.com
PUBLIC_ADMIN_URL=https://admin.business.example.com
SMTP_URL=
MAIL_FROM=OVL For Business <no-reply@business.example.com>

# Security rules (true by default)
REQUIRE_2FA_FOR_STAFF=true
REQUIRE_2FA_FOR_COMPANY_FINANCE=true
REQUIRE_VERIFIED_EMAIL=true
REQUIRE_IDENTITY_FOR_COMPANIES=true

# Uploaded files: a Docker volume by default, or an S3-compatible bucket (AWS, MinIO, R2…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10
